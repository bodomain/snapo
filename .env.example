# Copy to .env; never commit tokens or local replica files.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-token
# Each computer needs its OWN local database and device identity.
SNAPO_DB_PATH=/absolute/path/to/snapo/prodz.db
# Rust desktop: an independent SQLite file; never use a Turso replica here.
# Set AFTERMATH_DESKTOP_DB as an environment variable or pass --db to the app.
# AFTERMATH_DESKTOP_DB=/absolute/path/to/snapo/snapo-desktop.db
# For a completely separate local-only database, set SNAPO_LOCAL=1.
